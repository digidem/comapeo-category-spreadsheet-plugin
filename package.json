{
  "name": "comapeo-config-spreadsheet-plugin",
  "version": "2.0.0",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "version:update": "node src/scripts/update-version.cjs",
    "dev": "npm run version:update && clasp push --watch",
    "push": "npm run version:update && clasp push",
    "lint": "bunx biome lint --write --unsafe .",
    "test:gas-boot": "node src/scripts/check-gas-boot.cjs",
    "test:lint-parity": "node src/scripts/check-lint-parity.cjs",
    "test:custom-lang": "node src/scripts/check-custom-lang.cjs",
    "test:api-retry": "node src/scripts/check-api-retry.cjs",
    "test:translation-cancel": "node src/scripts/check-translation-cancel.cjs",
    "test:import-layout": "node src/scripts/check-import-layout.cjs",
    "test:job-status": "node src/scripts/check-job-status.cjs",
    "push:all": "npm run version:update && bash src/scripts/push-all.sh",
    "push:one": "npm run version:update && bash src/scripts/push-one.sh",
    "fixture": "bun run scripts/generate-fixture.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/google-apps-script": "^2.0.8",
    "biome": "^0.3.3",
    "typescript": "^6.0.2"
  }
}
